* text=auto

*.cs      text diff=csharp eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.asmdef  text eol=lf

# Unity YAML: let Unity's own format stand, never auto-merge line by line
*.unity   text merge=unityyamlmerge eol=lf
*.prefab  text merge=unityyamlmerge eol=lf
*.asset   text merge=unityyamlmerge eol=lf
*.meta    text eol=lf
*.mat     text merge=unityyamlmerge eol=lf
*.anim    text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.psd  binary
*.aseprite binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.fbx  binary
